{
  "redirects": [
    { "source": "/galeria/:path*", "destination": "/proyectos", "statusCode": 301 },
    { "source": "/trabajos/:path*", "destination": "/proyectos", "statusCode": 301 },
    { "source": "/servicios/:path*", "destination": "/servicios", "statusCode": 301 },
    { "source": "/productos/:path*", "destination": "/servicios", "statusCode": 301 },
    { "source": "/contacto/:path*", "destination": "/contacto", "statusCode": 301 },
    { "source": "/contacta/:path*", "destination": "/contacto", "statusCode": 301 },
    { "source": "/noticias/:path*", "destination": "/blog", "statusCode": 301 },
    { "source": "/blog/:path*", "destination": "/blog", "statusCode": 301 },
    { "source": "/boiserie/:path*", "destination": "/blog", "statusCode": 301 },
    { "source": "/lacado/:path*", "destination": "/blog", "statusCode": 301 },
    { "source": "/empresa-solidaria/:path*", "destination": "/blog", "statusCode": 301 },
    { "source": "/comoda/:path*", "destination": "/blog", "statusCode": 301 },
    { "source": "/:slug.html", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/((?!api|.well-known|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
